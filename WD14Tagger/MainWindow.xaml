<Window x:Class="WD14Tagger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WD14Tagger.ViewModels"
        Title="WD14 图片反推"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1040" MinHeight="620"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 顶栏 ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentBrush}">
                <TextBlock Text="🐋" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="WD14 图片反推" Style="{StaticResource TitleText}" FontSize="19" />
                <TextBlock Text="本地 ONNX 推理 · 结果写入 data\results.csv"
                           Style="{StaticResource SubText}" FontSize="11.5" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="模型" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="240" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource SubText}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ══ 工具条 ══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="选择目录" Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                    <Button Content="添加图片" Command="{Binding AddFilesCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                    <Button Content="开始反推" Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                    <Button Content="反推选中" Command="{Binding StartSelectedCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" MinWidth="66" />
                    <Button Content="停止" Command="{Binding StopCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,12,0" />
                    <Button Content="清空队列" Command="{Binding ClearCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                    <Button Content="删除选中" Command="{Binding RemoveSelectedCommand}"
                            Style="{StaticResource GhostButton}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="跳过已完成" IsChecked="{Binding SkipDone}" />
                    <CheckBox Content="含子目录" IsChecked="{Binding Recursive}" Margin="0,4,0,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 三栏内容 ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 队列 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,4,8">
                        <TextBlock Text="队列" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource SubText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                            Background="#EEF2FA" ClipToBounds="True">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TagsPreview}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="15" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding StateBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ElapsedText}" FontSize="10.5"
                                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🐋" FontSize="30" HorizontalAlignment="Center" Opacity="0.45" />
                        <TextBlock Text="把图片文件夹拖到这里" Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 预览 + 标签 -->
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,10"
                        Background="#EFF3FA">
                    <Grid>
                        <Image Source="{Binding DetailImage}" Stretch="Uniform" />
                        <TextBlock Text="选中队列里的图片即可预览"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetailImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="标签" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="7,2,7,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRating}" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="复制标签" Command="{Binding CopyTagsCommand}"
                                        Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="12,4" />
                            </StackPanel>
                        </Grid>

                        <TextBox Text="{Binding SelectedTagsText, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="110" MaxHeight="280"
                                 FontSize="13" Padding="10,8"
                                 Background="#FAFBFE" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 参数 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="检测参数" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="普通标签阈值" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding ThresholdText}" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="0.05" Maximum="0.95"
                                    Value="{Binding Threshold}" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.01" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="角色标签阈值" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding CharacterThresholdText}" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="0.05" Maximum="0.99"
                                    Value="{Binding CharacterThreshold}" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.01" Margin="0,0,0,10" />

                            <CheckBox Content="附带分级标签（general / sensitive / …）"
                                      IsChecked="{Binding OutputRating}" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="推理线程" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding ThreadsText}" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="1" Maximum="32"
                                    Value="{Binding Threads}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Text="线程数越多不一定越快，8 左右通常最稳。"
                                       Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="复制格式" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="只影响「复制标签」得到的文本，不影响存档结果。"
                                       Style="{StaticResource SubText}" FontSize="11" Margin="0,0,0,6"
                                       TextWrapping="Wrap" />
                            <CheckBox Content="下划线转空格" IsChecked="{Binding ReplaceUnderscore}" />
                            <CheckBox Content="末尾加逗号" IsChecked="{Binding TrailingComma}" />
                            <CheckBox Content="按分数排序" IsChecked="{Binding SortByScore}" />
                            <CheckBox Content="括号转义为 \( \)" IsChecked="{Binding EscapeParens}"
                                      ToolTip="复制成 a \(cosplay\) 的形式；不勾选则括号原样输出" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="模型目录" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ModelsPath}" Style="{StaticResource SubText}" FontSize="11"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="把 xxx.onnx 和同名 xxx.csv 放进上面的目录，重启软件即可。"
                                       Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ 底部状态 ══ -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SlimProgress}"
                         Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,0,0,7" />

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource SubText}" FontSize="12"
                           Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource SubText}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
