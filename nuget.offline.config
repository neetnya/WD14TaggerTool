<?xml version="1.0" encoding="utf-8"?>
<!--
  离线编译用的 NuGet 配置。联网环境不需要它，直接 dotnet publish 即可。
  用法见 README 的「自己编译」一节（publish 时加 configfile 开关指向本文件）。
  前置条件：把 Microsoft.ML.OnnxRuntime 等 nupkg 放进本目录下的 nuget-feed\。
  注意：XML 注释里不能出现连续两个减号，所以这里不直接写命令行。
-->
<configuration>
  <config>
    <!-- 还原缓存放在仓库内，避免污染系统全局缓存 -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="offline-local" value="nuget-feed" />
  </packageSources>
  <fallbackPackageFolders>
    <!-- 自包含发布需要运行时包，借用本机 .NET SDK 的全局缓存（只读） -->
    <add key="machineCache" value="%USERPROFILE%\.nuget\packages" />
  </fallbackPackageFolders>
</configuration>
